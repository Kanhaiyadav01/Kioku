# ── Kioku Project Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in ONE LLM key.
# Free Groq key: https://console.groq.com/keys
# Free Gemini key: https://aistudio.google.com/apikey

# Set ONE of the following (Gemini recommended for generous free tier):
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Optional Configuration ───────────────────────────────────────────────
# LLM Backend override: gemini | groq | none (auto-detected if blank)
# YTRAG_LLM_BACKEND=

# Vector store (Leave blank for embedded local Qdrant in ~/.ytrag/qdrant)
# QDRANT_URL=
# QDRANT_API_KEY=

# Embedding Model (Defaults to all-MiniLM-L6-v2 which matches prebuilt index)
# YTRAG_EMBED_MODEL=all-MiniLM-L6-v2

# Transcription Settings (For ingesting new playlists with GPU)
# YTRAG_WHISPER_MODEL=large-v3
# YTRAG_WHISPER_LANG=en
# YTRAG_WHISPER_DEVICE=auto
